---
// The lead story: the moving newswire, the "Developer" headline with the portrait, and previews of three stories.
---

<section class="page" aria-labelledby="lead-title">
  <div class="newswire ink" aria-hidden="true">
    <span class="newswire-label">On the record</span>
    <div class="newswire-window">
      <!-- Keep these copies identical: the animation travels exactly one group. -->
      <div class="newswire-track">
        <div class="newswire-group">
          <span>Full-stack development</span>
          <span>Java &amp; JavaScript</span>
          <span>Unity &amp; Unreal</span>
          <span>Open to opportunities</span>
        </div>
        <div class="newswire-group">
          <span>Full-stack development</span>
          <span>Java &amp; JavaScript</span>
          <span>Unity &amp; Unreal</span>
          <span>Open to opportunities</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-grid">
    <div class="hero-copy">
      <p class="story-kicker label">
        The lead story / Software &amp; game development
      </p>
      <h2 class="role-heading" id="lead-title" data-reveal>Developer</h2>
      <p class="byline">By Ahmed Ali <span>· Hamilton, Ontario</span></p>
      <div class="hero-description">
        <p class="drop-cap">
          I build full-stack applications and games. I like getting to the
          bottom of a problem and making something worth exploring.
        </p>
        <div class="classified">
          <p class="label">The opportunity column</p>
          <p>A first internship. <br /><em>A new chapter.</em></p>
          <a href="#contact">Open to internships ↗</a>
          <span class="label">Software Development student, April 2027</span>
        </div>
      </div>
    </div>
    <figure class="portrait" data-reveal>
      <div class="portrait-image">
        <img
          src="assets/img/profile-noir.jpg"
          alt="Black-and-white portrait of Ahmed Ali"
          width="600"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <span class="file-stamp" aria-hidden="true"
          >Byline<br /><strong>A. Ali</strong></span
        >
      </div>
      <figcaption class="label">
        <span>Fig. 01 / The developer</span><span>Hamilton dispatch</span>
      </figcaption>
    </figure>
  </div>

  <!-- Preview links open the matching project story further down the page. -->
  <div
    class="edition-stories"
    role="group"
    aria-label="Inside this edition"
  >
    <a
      class="news-preview news-preview-text"
      href="#case-tt"
      data-reveal
      data-delay="0"
    >
      <span class="label">Full-stack / The capstone</span>
      <h3>A better way <br />to find the next trade.</h3>
      <p>
        Tap to Trade connects local Magic: The Gathering players through
        inventories, offers and a shared collection.
      </p>
      <span class="preview-link label"
        >Read the story <span aria-hidden="true">↗</span></span
      >
    </a>
    <a class="news-preview" href="#case-eg" data-reveal data-delay="100">
      <div class="news-photo">
        <img
          src="assets/img/emotional-garden-poster.jpg"
          alt="Emotional Garden gameplay"
          width="1280"
          height="642"
          loading="lazy"
        />
      </div>
      <span class="label">Games / Emotional Garden</span>
      <h3>Where feelings <br />take root.</h3>
      <p>A quieter kind of game, built in Unity.</p>
      <span class="preview-link label"
        >Watch the recording <span aria-hidden="true">↗</span></span
      >
    </a>
    <a class="news-preview" href="#case-cp" data-reveal data-delay="200">
      <div class="news-photo">
        <img
          src="assets/img/cosmic-perfection-poster.jpg"
          alt="Cosmic Perfection gameplay"
          width="1920"
          height="1080"
          loading="lazy"
        />
      </div>
      <span class="label">Games / Cosmic Perfection</span>
      <h3>Order in <br />a field of chaos.</h3>
      <p>One small ship. A test of timing and nerve.</p>
      <span class="preview-link label"
        >Watch the recording <span aria-hidden="true">↗</span></span
      >
    </a>
  </div>
  <div class="hero-foot label">
    <span
      >Inside: featured stories / the personal column / at the press</span
    ><a href="#games"
      >Read the latest{" "}
      <span class="scroll-cue" aria-hidden="true">↓</span></a
    >
  </div>
</section>

---
import Case from "./Case.astro";
---

<!-- Each native details element is a story readers can open without JavaScript. -->
<section class="work paper" id="games" aria-labelledby="work-title">
  <div class="page">
    <div class="section-meta label">
      <span>Featured stories</span
      ><span>Four selected projects</span>
    </div>
    <h2 class="display-heading" id="work-title" data-reveal="headline">
      The stories
    </h2>
    <p class="work-intro">
      Four projects, four stories. Open a headline to read more.
    </p>
    <Case id="case-tt" number="03" title="Tap to Trade" category="Full-stack / Capstone" open>
      <div class="case-story">
        <p class="project-deck">
          Connecting local players,<br /><em>one trade at a time.</em>
        </p>
        <p>
          A marketplace for Magic: The Gathering players to share bulk
          inventories, search by card and city, and arrange in-person
          trades. My final-year capstone brings inventory management,
          offers and moderation into one web application.
        </p>
        <p>
          Searchable inventories and counter-offers help players find a
          match. Role-based moderation and report handling keep the
          community manageable.
        </p>
        <div class="actions">
          <a
            class="text-link"
            href="https://taptotrade.ca"
            target="_blank"
            rel="noopener"
            >Visit taptotrade.ca <span aria-hidden="true">↗</span></a
          >
          <a
            class="text-link"
            href="mailto:ahmedali.mohamed7597@gmail.com?subject=Tap%20to%20Trade%20source%20access"
            >Request source access <span aria-hidden="true">↗</span></a
          >
          <a
            class="text-link"
            href="mailto:ahmedali.mohamed7597@gmail.com?subject=About%20Tap%20to%20Trade"
            >Discuss the project <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
      <aside
        class="technical-record"
        id="tt-record"
        aria-label="Tap to Trade technical details"
      >
        <p class="label">The fact column / Project details</p>
        <dl class="fact-list">
          <div>
            <dt>Backend</dt>
            <dd>Node.js &amp; Express</dd>
          </div>
          <div>
            <dt>Database</dt>
            <dd>PostgreSQL</dd>
          </div>
          <div>
            <dt>Interface</dt>
            <dd>REST API</dd>
          </div>
          <div>
            <dt>Testing</dt>
            <dd>Jest &amp; Cypress</dd>
          </div>
          <div>
            <dt>Security testing</dt>
            <dd>OWASP ZAP</dd>
          </div>
          <div>
            <dt>Deployment</dt>
            <dd>Render</dd>
          </div>
        </dl>
        <p class="label record-foot">
          Mohawk College / Final-year capstone
        </p>
      </aside>
    </Case>

    <Case id="case-eg" number="01" title="Emotional Garden" category="Unity / C#">
      <figure class="demo">
        <video
          controls
          playsinline
          preload="none"
          poster="assets/img/emotional-garden-poster.jpg"
          width="1280"
          height="642"
          aria-label="Emotional Garden gameplay demo"
          aria-describedby="garden-caption"
          data-video
        >
          <source
            src="assets/videos/emotional-garden.mp4"
            type="video/mp4"
          />
          <a href="assets/videos/emotional-garden.mp4"
            >Download the Emotional Garden demo.</a
          >
        </video>
        <p class="video-status" role="status" hidden>
          The recording could not load. Try the download link below.
        </p>
        <figcaption id="garden-caption">
          <span>On screen / Emotional Garden</span
          ><a href="assets/videos/emotional-garden.mp4" download
            >Download clip ↓</a
          >
          <p class="clip-note" id="garden-voice-note">
            The voice in this clip is my project partner’s, not mine. We
            worked on Emotional Garden together.
          </p>
        </figcaption>
      </figure>
      <div class="case-story">
        <p class="project-deck">
          A quiet game about<br /><em>feelings that grow back.</em>
        </p>
        <p>
          A meditative Unity experience where each emotion becomes a
          seed to tend. Built in C# with hand-tuned shaders, ambient
          audio and a slow, deliberate sense of time.
        </p>
        <ul
          class="stack-list"
          aria-label="Emotional Garden technologies"
        >
          <li>Unity</li>
          <li>C#</li>
          <li>Shader Graph</li>
          <li>2D</li>
        </ul>
        <div class="actions">
          <a
            class="text-link"
            href="https://github.com/Ahmedali7597/EmotionalGarden"
            target="_blank"
            rel="noopener noreferrer"
            >View source <span aria-hidden="true">↗</span></a
          >
          <a
            class="text-link"
            href="mailto:ahmedali.mohamed7597@gmail.com?subject=About%20Emotional%20Garden"
            >Ask about it <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </Case>

    <Case id="case-cp" number="02" title="Cosmic Perfection" category="Unity / C#">
      <figure class="demo">
        <video
          controls
          playsinline
          preload="none"
          poster="assets/img/cosmic-perfection-poster.jpg"
          width="1920"
          height="1080"
          aria-label="Cosmic Perfection gameplay demo"
          aria-describedby="cosmic-caption"
          data-video
        >
          <source
            src="assets/videos/cosmic-perfection.mp4"
            type="video/mp4"
          />
          <a href="assets/videos/cosmic-perfection.mp4"
            >Download the Cosmic Perfection demo.</a
          >
        </video>
        <p class="video-status" role="status" hidden>
          The recording could not load. Try the download link below.
        </p>
        <figcaption id="cosmic-caption">
          <span>On screen / Cosmic Perfection</span
          ><a href="assets/videos/cosmic-perfection.mp4" download
            >Download clip ↓</a
          >
        </figcaption>
      </figure>
      <div class="case-story">
        <p class="project-deck">
          Precision and rhythm<br /><em>in a field of chaos.</em>
        </p>
        <p>
          Hundreds of projectiles. One small ship. A demanding Unity
          bullet-hell with carefully tuned collisions, responsive
          feedback, and attack patterns that reward practice.
        </p>
        <ul
          class="stack-list"
          aria-label="Cosmic Perfection technologies"
        >
          <li>Unity</li>
          <li>C#</li>
          <li>Bullet hell</li>
          <li>SFX &amp; VFX</li>
        </ul>
        <div class="actions">
          <a
            class="text-link"
            href="mailto:ahmedali.mohamed7597@gmail.com?subject=Cosmic%20Perfection%20build%20request"
            >Request a build <span aria-hidden="true">↗</span></a
          >
          <a class="text-link" href="#case-eg"
            >Previous story <span aria-hidden="true">↑</span></a
          >
        </div>
      </div>
    </Case>

    <Case id="case-film" number="04" title="The card film" category="Blender / Cycles">
      <figure class="demo">
        <video
          controls
          playsinline
          preload="none"
          poster="assets/img/card-film-poster.jpg"
          width="1280"
          height="720"
          aria-label="The Tap to Trade card film"
          aria-describedby="film-caption"
          data-video
        >
          <source src="assets/videos/card-film.mp4" type="video/mp4" />
          <a href="assets/videos/card-film.mp4">Download the card film.</a>
        </video>
        <p class="video-status" role="status" hidden>
          The recording could not load. Try the download link below.
        </p>
        <figcaption id="film-caption">
          <span>On screen / The Tap to Trade card film</span
          ><a href="assets/videos/card-film.mp4" download
            >Download clip ↓</a
          >
        </figcaption>
      </figure>
      <div class="case-story">
        <p class="project-deck">
          One hundred cards,<br /><em>sorted in ten seconds.</em>
        </p>
        <p>
          A short film for Tap to Trade. One hundred Magic: The
          Gathering cards lift off loose piles and glide into five
          alphabetical rows. A hard cut at three seconds swaps the
          overhead shot for a low one that pulls back on a longer lens.
        </p>
        <p>
          Every card’s path is planned so no two cards ever touch.
          Rendered in Blender Cycles at Full HD, 30 frames a second.
        </p>
        <ul class="stack-list" aria-label="Card film tools">
          <li>Blender</li>
          <li>Cycles</li>
          <li>Python</li>
          <li>FFmpeg</li>
        </ul>
        <div class="actions">
          <a
            class="text-link"
            href="https://taptotrade.ca"
            target="_blank"
            rel="noopener"
            >See it on taptotrade.ca <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
      <!-- The Artist card links here: one frame of the film in three Blender views. -->
      <figure class="bts" id="film-bts">
        <figcaption class="label">
          Behind the scenes / Frame 160 of the film, in Blender
        </figcaption>
        <!-- Radio buttons switch the view like Blender's shading buttons; CSS alone shows the chosen frame. -->
        <fieldset class="bts-switch">
          <legend class="visually-hidden">Blender view</legend>
          <label
            ><input type="radio" name="bts-view" value="wireframe" checked />
            Wireframe</label
          >
          <label
            ><input type="radio" name="bts-view" value="solid" />
            Solid</label
          >
          <label
            ><input type="radio" name="bts-view" value="render" />
            Final render</label
          >
        </fieldset>
        <div class="bts-frame">
          <img
            class="bts-wireframe"
            src="assets/img/film-wireframe.jpg"
            alt="Wireframe view: the sorting box, card rows and bedroom furniture drawn as lines"
            width="1280"
            height="720"
            loading="lazy"
          />
          <img
            class="bts-solid"
            src="assets/img/film-solid.jpg"
            alt="Solid view: the same frame as plain grey shapes, with cards rising above the box"
            width="1280"
            height="720"
            loading="lazy"
          />
          <img
            class="bts-render"
            src="assets/img/film-render.jpg"
            alt="Final Cycles render of the same frame, with card art, lighting and motion blur"
            width="1280"
            height="720"
            loading="lazy"
          />
        </div>
        <p class="clip-note">
          Bedroom scene: Bedroom With Cycles by SlykDrako (CC0). Card
          images from Scryfall; Magic: The Gathering is © Wizards of the
          Coast.
        </p>
      </figure>
    </Case>
  </div>
</section>

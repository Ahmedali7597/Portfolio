{
  "color": {
    "paper": {
      "$value": "#fafafa",
      "$type": "color"
    },
    "headline-ink": {
      "$value": "#2a2722",
      "$type": "color"
    },
    "noir": {
      "$value": "#0a090d",
      "$type": "color"
    },
    "ash": {
      "$value": "#666666",
      "$type": "color"
    },
    "pebble": {
      "$value": "#b3b3b3",
      "$type": "color"
    },
    "midstone": {
      "$value": "#9f9f9f",
      "$type": "color"
    },
    "sepia": {
      "$value": "#3e3b36",
      "$type": "color"
    }
  },
  "font": {
    "masthead": {
      "$value": "\"Anton\", Impact, \"Arial Narrow\", sans-serif",
      "$type": "fontFamily"
    },
    "display": {
      "$value": "\"Cormorant Garamond\", Georgia, \"Times New Roman\", serif",
      "$type": "fontFamily"
    },
    "body": {
      "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "$type": "fontFamily"
    },
    "label": {
      "$value": "\"Courier New\", monospace",
      "$type": "fontFamily"
    }
  },
  "layout": {
    "page-gutter": {
      "$value": "clamp(1rem, 2vw, 2.5rem)",
      "$type": "dimension"
    },
    "section-space": {
      "$value": "clamp(4rem, 9vw, 9rem)",
      "$type": "dimension"
    }
  },
  "text": {
    "caption": {
      "$value": "0.75rem",
      "$type": "dimension"
    }
  },
  "duration": {
    "fast": {
      "$value": "140ms",
      "$type": "duration"
    },
    "panel": {
      "$value": "240ms",
      "$type": "duration"
    },
    "reveal": {
      "$value": "650ms",
      "$type": "duration"
    },
    "marquee": {
      "$value": "32s",
      "$type": "duration"
    },
    "shadows": {
      "$value": "9s",
      "$type": "duration"
    }
  },
  "ease": {
    "out": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$type": "string"
    }
  },
  "surface": {
    "paper": {
      "$value": "{color.paper}",
      "$type": "color"
    },
    "ink": {
      "$value": "{color.headline-ink}",
      "$type": "color"
    }
  }
}

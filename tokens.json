{
  "color": {
    "paper": {
      "$value": "#f0ece3",
      "$type": "color"
    },
    "headline-ink": {
      "$value": "#2a2722",
      "$type": "color"
    },
    "noir": {
      "$value": "#0a090d",
      "$type": "color"
    },
    "ash": {
      "$value": "#666666",
      "$type": "color"
    },
    "pebble": {
      "$value": "#b3b3b3",
      "$type": "color"
    },
    "midstone": {
      "$value": "#9f9f9f",
      "$type": "color"
    },
    "night-paper": {
      "$value": "#171816",
      "$type": "color"
    },
    "night-panel": {
      "$value": "#252622",
      "$type": "color"
    },
    "night-ink": {
      "$value": "#e9e4d9",
      "$type": "color"
    },
    "night-muted": {
      "$value": "#b3b0a6",
      "$type": "color"
    },
    "night-rule": {
      "$value": "#62635c",
      "$type": "color"
    }
  },
  "font": {
    "masthead": {
      "$value": "\"Anton\", Impact, \"Arial Narrow\", sans-serif",
      "$type": "fontFamily"
    },
    "display": {
      "$value": "\"Cormorant Garamond\", Georgia, \"Times New Roman\", serif",
      "$type": "fontFamily"
    },
    "body": {
      "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "$type": "fontFamily"
    },
    "label": {
      "$value": "\"Courier New\", monospace",
      "$type": "fontFamily"
    },
    "newsprint": {
      "$value": "\"UnifrakturMaguntia\", Georgia, serif",
      "$type": "fontFamily"
    }
  },
  "layout": {
    "page-gutter": {
      "$value": "clamp(1rem, 2vw, 2.5rem)",
      "$type": "dimension"
    },
    "section-space": {
      "$value": "clamp(4rem, 9vw, 9rem)",
      "$type": "dimension"
    }
  },
  "text": {
    "caption": {
      "$value": "0.75rem",
      "$type": "dimension"
    }
  },
  "duration": {
    "fast": {
      "$value": "140ms",
      "$type": "duration"
    },
    "panel": {
      "$value": "240ms",
      "$type": "duration"
    },
    "reveal": {
      "$value": "850ms",
      "$type": "duration"
    },
    "marquee": {
      "$value": "24s",
      "$type": "duration"
    },
    "shadows": {
      "$value": "6s",
      "$type": "duration"
    },
    "role": {
      "$value": "380ms",
      "$type": "duration"
    },
    "role-hold": {
      "$value": "3200ms",
      "$type": "duration"
    }
  },
  "ease": {
    "out": {
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$type": "string"
    }
  },
  "surface": {
    "paper": {
      "$value": "{color.paper}",
      "$type": "color"
    },
    "ink": {
      "$value": "{color.headline-ink}",
      "$type": "color"
    },
    "dark": {
      "$value": "{color.night-paper}",
      "$type": "color"
    },
    "dark-panel": {
      "$value": "{color.night-panel}",
      "$type": "color"
    }
  }
}

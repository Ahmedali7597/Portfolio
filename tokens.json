{
  "color": {
    "paper": {
      "$value": "#fafafa",
      "$type": "color",
      "$description": "Paper — Page background, card surfaces, inverted-section type — the cream-white ground that all dark type sits on"
    },
    "hairline": {
      "$value": "#eeeeee",
      "$type": "color",
      "$description": "Hairline — Card and tile borders — only visible against Paper"
    },
    "midstone": {
      "$value": "#9f9f9f",
      "$type": "color",
      "$description": "Midstone — Nav borders, muted borders, light decorative borders on dark sections"
    },
    "ash": {
      "$value": "#666666",
      "$type": "color",
      "$description": "Ash — Secondary borders, muted UI text, low-emphasis dividers"
    },
    "pebble": {
      "$value": "#b3b3b3",
      "$type": "color",
      "$description": "Pebble — Inactive nav text and borders"
    },
    "sepia": {
      "$value": "#3e3b36",
      "$type": "color",
      "$description": "Sepia — Strong borders, secondary heading text — the warm-brown near-black that flanks Headline Ink"
    },
    "headline-ink": {
      "$value": "#2a2722",
      "$type": "color",
      "$description": "Headline Ink — Primary text, body ink, dominant borders, nav rules — warm near-black that carries every word on the page"
    },
    "noir": {
      "$value": "#0a090d",
      "$type": "color",
      "$description": "Original noir portfolio canvas; separate from headline ink."
    }
  },
  "font": {
    "display": {
      "$value": "\"Cormorant Garamond\", Georgia, \"Times New Roman\", serif",
      "$type": "fontFamily"
    },
    "body": {
      "$value": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "$type": "fontFamily"
    }
  },
  "weight": {
    "regular": {
      "$value": 400,
      "$type": "fontWeight"
    },
    "medium": {
      "$value": 500,
      "$type": "fontWeight"
    },
    "semibold": {
      "$value": 600,
      "$type": "fontWeight"
    }
  },
  "text": {
    "caption": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "label": {
      "$value": "0.875rem",
      "$type": "dimension"
    },
    "body": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "lede": {
      "$value": "1.25rem",
      "$type": "dimension"
    },
    "subheading": {
      "$value": "2rem",
      "$type": "dimension"
    },
    "project": {
      "$value": "clamp(2.5rem, 3.6vw, 3.5rem)",
      "$type": "dimension"
    },
    "heading": {
      "$value": "clamp(3rem, 6.2vw, 5rem)",
      "$type": "dimension"
    },
    "masthead": {
      "$value": "clamp(5rem, 15vw, 13rem)",
      "$type": "dimension"
    }
  },
  "leading": {
    "body": {
      "$value": 1.6,
      "$type": "number"
    },
    "heading": {
      "$value": 1.05,
      "$type": "number"
    }
  },
  "tracking": {
    "caps": {
      "$value": "0.09em",
      "$type": "string"
    }
  },
  "space": {
    "4": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "8": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "12": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "16": {
      "$value": "1rem",
      "$type": "dimension"
    },
    "20": {
      "$value": "1.25rem",
      "$type": "dimension"
    },
    "24": {
      "$value": "1.5rem",
      "$type": "dimension"
    },
    "32": {
      "$value": "2rem",
      "$type": "dimension"
    },
    "48": {
      "$value": "3rem",
      "$type": "dimension"
    },
    "64": {
      "$value": "4rem",
      "$type": "dimension"
    },
    "80": {
      "$value": "5rem",
      "$type": "dimension"
    }
  },
  "layout": {
    "page-width": {
      "$value": "80rem",
      "$type": "dimension"
    },
    "page-gutter": {
      "$value": "clamp(1.25rem, 4.5vw, 4rem)",
      "$type": "dimension"
    },
    "section-space": {
      "$value": "clamp(3.5rem, 6vw, 6rem)",
      "$type": "dimension"
    },
    "column-gap": {
      "$value": "clamp(1.5rem, 3.4vw, 3rem)",
      "$type": "dimension"
    }
  },
  "radius": {
    "action": {
      "$value": "0.75rem",
      "$type": "dimension"
    }
  },
  "duration": {
    "fast": {
      "$value": "160ms",
      "$type": "duration"
    }
  },
  "surface": {
    "paper": {
      "$value": "{color.paper}",
      "$type": "color"
    },
    "ink": {
      "$value": "{color.noir}",
      "$type": "color"
    }
  }
}
